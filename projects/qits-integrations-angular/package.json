{
  "name": "@qits/angular",
  "version": "2026.1113.41853",
  "description": "qits integration for Angular apps: config.json-gated OTEL telemetry (traces, logs, route/interaction/caller enrichment), feature capture, state snapshots, and the platform's bearer sign-in (OIDC code + PKCE).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/QuicklyIterateTheSoftware/qits-integrations-angular.git"
  },
  "homepage": "https://github.com/QuicklyIterateTheSoftware/qits-integrations-angular#readme",
  "keywords": [
    "qits",
    "angular",
    "opentelemetry",
    "telemetry",
    "feature-capture",
    "oidc"
  ],
  "peerDependencies": {
    "@angular/common": "^21.2.0 || ^22.1.0",
    "@angular/compiler": "^21.2.0 || ^22.1.0",
    "@angular/core": "^21.2.0 || ^22.1.0",
    "@angular/router": "^21.2.0 || ^22.1.0",
    "@angular/service-worker": "^21.2.0 || ^22.1.0",
    "@ngrx/signals": "^21.0.0 || ^22.0.1",
    "@pact-foundation/pact": "^17.1.4",
    "eslint": "^9.0.0 || ^10.0.0",
    "rxjs": "^7.4.0",
    "typescript": "^5.9.0 || ^6.0.0",
    "vitest": "^4.1.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/service-worker": {
      "optional": true
    },
    "@pact-foundation/pact": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.220.0",
    "@opentelemetry/instrumentation": "^0.220.0",
    "@opentelemetry/instrumentation-document-load": "^0.65.0",
    "@opentelemetry/instrumentation-fetch": "^0.220.0",
    "@opentelemetry/instrumentation-user-interaction": "^0.64.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-logs": "^0.220.0",
    "@opentelemetry/sdk-trace-web": "^2.9.0",
    "tslib": "^2.3.0"
  },
  "sideEffects": false,
  "bin": {
    "qits-angular": "./bin/qits-angular.mjs"
  },
  "exports": {
    "./eslint": {
      "default": "./eslint/index.mjs"
    },
    "./screenshots": {
      "types": "./screenshots/index.d.mts",
      "default": "./screenshots/index.mjs"
    }
  }
}
