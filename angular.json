{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "qits-integrations-angular": {
      "projectType": "library",
      "root": "projects/qits-integrations-angular",
      "sourceRoot": "projects/qits-integrations-angular/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/qits-integrations-angular/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/qits-integrations-angular/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/qits-integrations-angular/tsconfig.spec.json",
            "include": ["**/*.spec.ts", "../testing/**/*.spec.ts"],
            "exclude": ["projects/qits-integrations-angular/src/**/*.browser.spec.ts"]
          }
        },
        "test-browser": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/qits-integrations-angular/tsconfig.spec.json",
            "browsers": ["chromium"],
            "headless": true,
            "include": ["projects/qits-integrations-angular/src/**/*.browser.spec.ts"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/qits-integrations-angular/**/*.ts",
              "projects/qits-integrations-angular/**/*.html"
            ],
            "eslintConfig": "projects/qits-integrations-angular/eslint.config.js"
          }
        }
      }
    }
  }
}
